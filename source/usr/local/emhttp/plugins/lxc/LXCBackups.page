Menu="LXC:2"
Title="Backups"
Tag="archive"
Cond="exec(\"lxc-ls 2>/dev/null\") && parse_ini_file('/boot/config/plugins/lxc/plugin.cfg')['LXC_BACKUP_SERVICE'] == 'enabled'"
---
<?php
require_once '/usr/local/emhttp/plugins/lxc/include/Container.php';
$settings = new Settings();
$allContainers = getAllContainers();
?>

<link rel="stylesheet" type="text/css" href="/plugins/lxc/css/lxc.css">
<?= lxc_i18n_js() ?>
<script type="text/javascript" src="/plugins/lxc/js/lxc.js"></script>

<?php
foreach ($allContainers as $container) { ?>
        <h2><?= $container->name ?></h2>
        <br>
        <table id="snapshot_table" class="tablesorter two shift">
            <thead>
            <tr>
                <th style='width: 300px;'><?= lxc_t('Name') ?></th>
                <th style='width: 400px; min-width: 150px; max-width: 150px;'><?= lxc_t('Date/Time') ?></th>
                <th style='min-width: 500px;'><?= lxc_t('Actions') ?></th>
            </tr>
            </thead>
            <tbody align="left">
<?

        if (count($container->backups) > 0) {
          foreach ($container->backups as $backup) {
            ?>
            <tr style='height: 50px;'>
              <td>
                <?= $backup->name?>
              </td>
              <td>
                <?= $backup->date ?> <?= $backup->time ?>
              </td>
              <td>
                <a href='/LXC/RestoreLXCBackup?cont=<?= $container->name?>&backup=<?= $backup->time ?>_<?= $backup->date ?>.tar.xz' class='button'>
                  <?= lxc_t('Create Container From Backup') ?>
                </a>
                <a href="#" class="button deleteBACKUP" id="<?= $container->name ?> <?= $backup->name ?>_<?= $backup->time ?>_<?= $backup->date ?>">
                  <?= lxc_t('Delete Backup') ?>
                </a>
              </td>
            </tr>
<?php
          }
        } else {
          echo "<tr style='height: 50px;'><td>" . lxc_t('No Backups') . "</td><td>&nbsp;</td><td>&nbsp;</td></tr>";
        }
          echo "</tbody></table>";
}

?>
