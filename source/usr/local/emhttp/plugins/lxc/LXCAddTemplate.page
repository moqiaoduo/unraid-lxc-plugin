<script>
  /**
   * Import panel shown when /tmp/lxc_container_template.xml is missing or invalid.
   * The old workflow (wget the XML, then reload) stays untouched; this only adds
   * a way to get the file there without opening a terminal.
   */
  (function () {
    var panel = document.getElementById('lxcImportPanel');
    if (!panel) {
      return;
    }
    var url = document.getElementById('lxcImportUrl');
    var button = document.getElementById('lxcImportUrlButton');
    var file = document.getElementById('lxcImportFile');
    var message = document.getElementById('lxcImportMessage');

    function fail(text) {
      message.textContent = text;
    }

    function send(data) {
      message.textContent = '';
      $.post('/plugins/lxc/include/ajax.php', $.extend({lxc: '', action: 'importTemplate'}, data))
        .done(function (result) {
          if (result && result.ok) {
            window.location.reload();
            return;
          }
          fail((result && result.error) || LXC_T('ERROR, failed to import the template'));
        })
        .fail(function (xhr) {
          var text = $(xhr.responseText || '').text().trim();
          fail(text || LXC_T('ERROR, failed to import the template'));
        });
    }

    if (button) {
      button.addEventListener('click', function () {
        var value = url ? url.value.trim() : '';
        if (!value) {
          fail(LXC_T('Enter a template URL first.'));
          return;
        }
        send({source: 'url', url: value});
      });
    }

    if (file) {
      file.addEventListener('change', function () {
        var selected = file.files && file.files[0];
        if (!selected) {
          return;
        }
        if (selected.size > 524288) {
          fail(LXC_T('ERROR, the template is too large'));
          return;
        }
        var reader = new FileReader();
        reader.onload = function () {
          send({source: 'text', content: String(reader.result)});
        };
        reader.onerror = function () {
          fail(LXC_T('ERROR, failed to read the file'));
        };
        reader.readAsText(selected);
      });
    }
  })();
</script>
