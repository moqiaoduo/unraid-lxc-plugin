require_once '/usr/local/emhttp/plugins/lxc/include/Settings.php';
$settings = new Settings();

// Templates live on the flash drive. ?xmlTemplate=user:<file> mirrors the
// Docker add page, so a bookmark or a future CA integration can open one.
$templates = [];
foreach ((array)@glob(lxc_template_dir() . '/*.xml') as $templateFile) {
  $templates[] = $templateFile;
}
$selectedTemplate = '';
$templatePath = '';
$requested = isset($_GET['xmlTemplate']) ? (string)$_GET['xmlTemplate'] : '';
if ($requested !== '') {
  $candidate = '';
  if (preg_match('/^user:(.+)$/', $requested, $matches)) {
    $candidate = lxc_template_dir() . '/' . basename($matches[1]);
  } elseif (preg_match('#^/tmp/[^/]+$#', $requested) || preg_match('#^/boot/config/plugins/lxc/templates/[^/]+$#', $requested)) {
    $candidate = $requested;
  }
  if ($candidate !== '' && is_file($candidate)) {
    $templatePath = $candidate;
  }
}
$template = false;
if ($templatePath !== '') {
  $loadedTemplate = @simplexml_load_file($templatePath, 'SimpleXMLElement', LIBXML_NONET);
  if ($loadedTemplate !== false && $loadedTemplate->getName() === 'LXC') {
    $template = $loadedTemplate;
    $selectedTemplate = basename($templatePath, '.xml');
  } else {
    $templatePath = '';
  }
}
$tplName = $template !== false ? trim((string)$template->Name) : '';
$tplDescription = $template !== false ? trim((string)$template->Description) : '';
$tplRepository = $template !== false ? trim((string)$template->Repository) : '';
$tplWebui = $template !== false ? trim((string)$template->WebUI) : '';
// A template's <Description> is usually a comma separated keyword list rather
// than a sentence, so show it as tags and keep the container description free.
$tplTags = [];
if ($selectedTemplate !== '' && $tplDescription !== '') {
  foreach (preg_split('/[,;]+/', $tplDescription) as $tag) {
    $tag = trim($tag);
    if ($tag !== '') {
      $tplTags[] = $tag;
    }
  }
}
$tplIcon = $template !== false ? trim((string)$template->Icon) : '';
// Docker templates keep HTML in <Overview> bracketed as [b]…[/b] so the XML
// stays valid; turn that back into markup and show the plain text below the
// container name, like the Docker add page does.
$tplOverview = $template !== false ? (string)$template->Overview : '';
$overviewHtml = lxc_template_overview_html($tplOverview);

$started = $var['fsState'] == 'Started';
$macaddress = getNewMacAddress();

$avail_images = [];
$avail_images_json = '[]';
$json_data = [];
if ($template === false) {
  if ($settings->default_cont_url === 'images.linuxcontainers.org') {
    // Get images from linuxcontainers.org
    downloadLXCproducts('https://images.linuxcontainers.org/meta/simplestreams/v1/index.json');
  } else {
    downloadLXCproducts('https://' . $settings->default_cont_url . '/meta/simplestreams/v1/index.json');
  }

  // Filter out only products from json
  $json_data = @file_get_contents('/tmp/lxc/lxcimages.json');
  $json_data = json_decode($json_data, true);
  if (isset($json_data['index']['images']['products'])) {
    $json_data = json_encode($json_data['index']['images']['products']);
    $json_data = json_decode($json_data, true);

    foreach ($json_data as $item) {
      list($distribution, $release, $architecture, $type) = explode(':', $item);
      $avail_images[$distribution][$release][$architecture][$type] = true;
    }
    $avail_images_json = json_encode($avail_images);
  } else {
    $json_data = [];
  }
}
$bridges = getInterfaces();
?>


