<script>
$(function () {
  var $select = $('#lxcTemplateSelect');

  // The advanced view is a display preference, not part of the container, so
  // remember it per browser. Fields hidden here are still submitted.
  var $form = $('#addContainer');
  var $view = $('#lxcAdvancedView');
  var viewKey = 'lxcAddAdvanced';
  $view.prop('checked', localStorage.getItem(viewKey) === '1');
  if (typeof $.fn.switchButton === 'function') {
    $view.switchButton({labels_placement:'right', on_label: LXC_T('Advanced'), off_label: LXC_T('Simple')});
  }
  function applyView() {
    var advanced = $view.prop('checked');
    $form.toggleClass('lxc-simple-view', !advanced);
    localStorage.setItem(viewKey, advanced ? '1' : '0');
  }
  $view.on('change', applyView);
  applyView();

  $select.on('change', function () {
    var name = $(this).val();
    location.href = name === ''
      ? '/LXC/AddLXCContainer'
      : '/LXC/AddLXCContainer?xmlTemplate=user:' + encodeURIComponent(name + '.xml');
  });

  $('#lxcImportTemplate').on('click', function () {
    showPrompt(function (url) {
      if (!url) {
        return;
      }
      $.post('/plugins/lxc/include/ajax.php',
        { lxc: '', action: 'importTemplate', source: 'url', url: url },
        function (result) {
          if (result.ok) {
            location.href = '/LXC/AddLXCContainer?xmlTemplate=user:' + encodeURIComponent(result.name + '.xml');
          } else {
            alert(result.error || LXC_T('ERROR, failed to import the template'));
          }
        }, 'json');
    }, LXC_T('Import Template'), LXC_T('Enter the https:// URL of an LXC template XML file:'), 'https://');
  });

  $('#lxcDeleteTemplate').on('click', function () {
    var name = $select.val();
    if (!name) {
      return;
    }
    showDialog(function (confirmed) {
      if (!confirmed) {
        return;
      }
      $.post('/plugins/lxc/include/ajax.php',
        { lxc: '', action: 'deleteTemplate', name: name },
        function (result) {
          if (result.ok) {
            location.href = '/LXC/AddLXCContainer';
          } else {
            alert(result.error || LXC_T('ERROR, the template does not exist!'));
          }
        }, 'json');
    }, LXC_TF('Delete the template %s?', name), LXC_T('Delete Template'));
  });
});
</script>


