Title="Copy LXC Container"
Markdown="false"
---
<?php
require_once '/usr/local/emhttp/plugins/lxc/include/i18n.php';
require_once '/usr/local/emhttp/plugins/lxc/include/Settings.php';
$settings = new Settings();
$started = $var['fsState']=='Started';
$container = $_GET['cont'] ?? '';
?>
<script>
  let container = <?= json_encode($container); ?>;
</script>

<?= lxc_i18n_js() ?>
<link rel="stylesheet" href="/plugins/lxc/css/lxc.css">
<script src="/plugins/lxc/js/lxc.js"></script>

<div id="canvas">
<form method="post" id="copyCont" autocomplete="off">

<div class="">
<dl>
<dt><?= lxc_t('Container Name:') ?></dt>
<dd><input type="text" name="contName" pattern="[a-zA-Z0-9][a-zA-Z0-9_.-]+" placeholder="<?= htmlspecialchars($container, ENT_QUOTES, 'UTF-8') ?>_copy" required></dd>
</dl>
</div>

<div class="">
<dl>
<dt><?= lxc_t('Container Description:') ?></dt>
<dd><input type="text" name="contDesc" pattern="[A-Za-z0-9 \-_,.]{1,50}" placeholder="<?= lxc_t('Your Description or empty') ?>">
</dd>
</dl>
</div>

<div class="">
<dl>
<dt><?= lxc_t('Copy From:') ?></dt>
<dd><input type="text" name="contSnap" required value="<?= htmlspecialchars($container, ENT_QUOTES, 'UTF-8') ?>" disabled></dd>
</dl>
</div>

<div class="">
<dl>
<dt><?= lxc_t('Mac Address:') ?></dt>
  <dd style="display: grid;">
    <input type="text" name="contMac" required id="mac" style="text-transform:uppercase" value="<?= getNewMacAddress(); ?>">
    <div id="emac" class="emac"><?= lxc_t('Invalid MAC address') ?></div>
  </dd>
</dl>
</div>

<div class="">
<dl>
<dt><?= lxc_t('Autostart:') ?></dt>
<dd><input type="checkbox" name="contAutostart" checked></dd>
</dl>
</div>

<input type="submit" value="<?= lxc_t('Create') ?>">
<a href="/LXC" class="button"><?= lxc_t('Done') ?></a>

</form>
</div>
