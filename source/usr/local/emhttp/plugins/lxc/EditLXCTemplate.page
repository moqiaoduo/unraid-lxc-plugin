Title="Edit LXC Template"
Markdown="false"
---
<?php
require_once '/usr/local/emhttp/plugins/lxc/include/i18n.php';
require_once '/usr/local/emhttp/plugins/lxc/include/functions.php';

$templateParam = $_GET['template'] ?? '';
$templateName = is_string($templateParam) ? lxc_template_name($templateParam) : '';
$templateFile = $templateName === '' ? '' : lxc_template_dir() . '/' . $templateName . '.xml';
$valid = $templateFile !== '' && is_file($templateFile);
$templateText = $valid ? (string)file_get_contents($templateFile) : '';

// Match the configuration editor: Ace follows the GUI theme.
$themeName = isset($theme) ? (string)$theme : 'white';
$darkTheme = isset($themeHelper) && method_exists($themeHelper, 'isDarkTheme')
  ? $themeHelper->isDarkTheme()
  : in_array($themeName, ['black', 'gray'], true);
$aceTheme = $darkTheme ? 'ace/theme/tomorrow_night' : 'ace/theme/tomorrow';
?>
<link rel="stylesheet" href="/plugins/lxc/css/lxc.css">
<?= lxc_i18n_js() ?>
<script src="<?autov('/plugins/lxc/js/lxc.js')?>"></script>
<?php if ($valid): ?>
<script src="<?autov('/webGui/javascript/ace/ace.js')?>"></script>
<script src="<?autov('/webGui/javascript/ace/mode-xml.js')?>"></script>
<script src="<?autov('/webGui/javascript/ace/theme-tomorrow.js')?>"></script>
<script src="<?autov('/webGui/javascript/ace/theme-tomorrow_night.js')?>"></script>
<?php endif; ?>

<div id="canvas">
<?php if (!$valid): ?>
  <p class="lxc-error" style="color:red;"><?= lxc_t('ERROR, the template does not exist!') ?></p>
  <p><a href="/LXC/AddLXCContainer" class="button"><?= lxc_t('Done') ?></a></p>
<?php else: ?>

  <div class="lxc-edit-header">
    <h2><?= htmlspecialchars($templateName . '.xml', ENT_QUOTES, 'UTF-8') ?></h2>
  </div>

  <div id="templateEditor"></div>

  <p class="lxc-template-actions">
    <input type="button" id="lxcSaveTemplate" value="<?= lxc_t('Save Template') ?>">
    <input type="button" id="lxcSaveTemplateBack" value="<?= lxc_t('Save and Return') ?>">
    <input type="button" id="lxcDeleteTemplate" class="danger" value="<?= lxc_t('Delete Template') ?>">
    <a href="/LXC/AddLXCContainer?xmlTemplate=user:<?= urlencode($templateName . '.xml') ?>" class="button"><?= lxc_t('Back to Add Container') ?></a>
    <span id="lxcTemplateStatus"></span>
  </p>

  <script>
  $(function () {
    var editor = ace.edit('templateEditor');
    editor.session.setMode('ace/mode/xml');
    editor.session.setValue(<?= json_encode($templateText) ?>, -1);
    editor.setOptions({
      showPrintMargin: false,
      fontSize: 13,
      fontFamily: 'bitstream'
    });
    editor.setTheme(<?= json_encode($aceTheme) ?>);

    function save(goBack) {
      $.post('/plugins/lxc/include/ajax.php',
        { lxc: '', action: 'saveTemplate', name: <?= json_encode($templateName) ?>, content: editor.getValue() },
        function (result) {
          if (!result.ok) {
            alert(result.error || LXC_T('ERROR, failed to save the template'));
            return;
          }
          if (goBack) {
            location.href = '/LXC/AddLXCContainer?xmlTemplate=user:' + encodeURIComponent(<?= json_encode($templateName . '.xml') ?>);
          } else {
            $('#lxcTemplateStatus').text(LXC_T('Saved'));
          }
        }, 'json');
    }

    $('#lxcSaveTemplate').on('click', function () { save(false); });
    $('#lxcSaveTemplateBack').on('click', function () { save(true); });

    $('#lxcDeleteTemplate').on('click', function () {
      showDialog(function (confirmed) {
        if (!confirmed) {
          return;
        }
        $.post('/plugins/lxc/include/ajax.php',
          { lxc: '', action: 'deleteTemplate', name: <?= json_encode($templateName) ?> },
          function (result) {
            if (result.ok) {
              location.href = '/LXC/AddLXCContainer';
            } else {
              alert(result.error || LXC_T('ERROR, the template does not exist!'));
            }
          }, 'json');
      }, LXC_TF('Delete the template %s?', <?= json_encode($templateName . '.xml') ?>), LXC_T('Delete Template'));
    });
  });
  </script>

<?php endif; ?>
</div>