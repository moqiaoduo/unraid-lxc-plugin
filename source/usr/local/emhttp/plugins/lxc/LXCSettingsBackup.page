<form markdown="1" id="changebackupcfg" method="post" >
<dl>
<dt><?= lxc_t('Enable Global Backup settings:') ?></dt>
<dd>
<select id="backup_enabled" name="BACKUP_ENABLED">
  <?= mk_option($settings->backup_enabled, 'disabled', lxc_t('No'))?>
  <?= mk_option($settings->backup_enabled, 'enabled', lxc_t('Yes'))?>
  </select>

<blockquote class="inline_help">
<p><?= lxc_t('Enable or Disable Global Backup settings') ?></p>
